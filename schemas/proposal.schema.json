{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kakera 0.1 纯文本拆幕提案", "type": "object", "additionalProperties": false,
  "required": ["schema", "operations"],
  "properties": {
    "schema": { "const": 1 },
    "operations": { "type": "array", "minItems": 1, "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["type", "start", "end", "text"],
      "properties": { "type": { "const": "createFrame" }, "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1 } }
    } }
  }
}
